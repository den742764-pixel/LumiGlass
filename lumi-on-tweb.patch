diff --git a/.github/workflows/android.yml b/.github/workflows/android.yml
new file mode 100644
index 0000000..4f67610
--- /dev/null
+++ b/.github/workflows/android.yml
@@ -0,0 +1,54 @@
+name: Build Lumi APK
+
+on:
+  workflow_dispatch:
+  push:
+    branches: [master, main]
+
+jobs:
+  apk:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: pnpm/action-setup@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22
+          cache: pnpm
+
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 17
+
+      - name: Install deps
+        run: pnpm install --frozen-lockfile
+
+      - name: Build web app
+        env:
+          VITE_API_ID: ${{ secrets.VITE_API_ID }}
+          VITE_API_HASH: ${{ secrets.VITE_API_HASH }}
+        run: pnpm exec vite build
+
+      - name: Wrap in Capacitor
+        run: |
+          mkdir -p /tmp/cap && cp capacitor.config.json /tmp/cap/
+          cd /tmp/cap
+          npm init -y >/dev/null
+          npm i @capacitor/core @capacitor/cli @capacitor/android
+          cp -r "$GITHUB_WORKSPACE/dist" ./dist
+          npx cap add android
+          npx cap sync android
+          # иконка Луми
+          for d in mdpi hdpi xhdpi xxhdpi xxxhdpi; do
+            for f in ic_launcher ic_launcher_round ic_launcher_foreground; do
+              cp "$GITHUB_WORKSPACE/public/assets/img/android-chrome-192x192.png" "android/app/src/main/res/mipmap-$d/$f.png"
+            done
+          done
+          cd android && ./gradlew assembleDebug
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: lumi-apk
+          path: /tmp/cap/android/app/build/outputs/apk/debug/app-debug.apk
diff --git a/LUMI_README.md b/LUMI_README.md
new file mode 100644
index 0000000..234b43e
--- /dev/null
+++ b/LUMI_README.md
@@ -0,0 +1,29 @@
+# Луми на исходниках Telegram Web K
+
+Форк официального клиента [morethanwords/tweb](https://github.com/morethanwords/tweb) (GPL v3).
+Логика, протокол MTProto, магазин подарков и Stars, звонки, истории — всё штатное, как в Telegram.
+Поменян только вид и нижнее меню.
+
+## Что сделано
+- **Жидкое стекло везде**: шапка чата, поле ввода, кнопки, меню, окна, поиск, папки, настройки, список чатов
+  (`src/scss/partials/_lumi.scss`, подключён последним в `src/scss/style.scss`).
+- **Шторки чата как в Луми**: шапка и поле ввода — отдельные плавающие стеклянные капсулы, сообщения без «хвостиков».
+- **Нижнее меню Луми** (`src/components/lumiNav.ts`): Чаты · Контакты · Профиль · Настройки,
+  подвижная «пилюля» с названием, перетаскивание пальцем, вибрация. Без ленты и без клипов.
+- **Магазин Telegram** остался: подарки и Stars доступны в профиле и настройках (раздел «Мои звёзды»).
+- Тёмная тема по умолчанию, название «Луми», иконки из Луми.
+
+## Запуск
+1. Получите свои `api_id` и `api_hash` на https://my.telegram.org (обязательно свои, не от Telegram Web).
+2. Создайте файл `.env`:
+   ```
+   VITE_API_ID=ВАШ_ID
+   VITE_API_HASH=ВАШ_HASH
+   ```
+3. `pnpm install`, затем `pnpm start` (разработка на :8080) или `pnpm build` (готовая сборка в `dist/`).
+
+## Важно
+- Лицензия GPL v3: форк нужно публиковать с исходным кодом.
+- Сервер Telegram закрыт — клиент работает через их API, своего бэкенда нет.
+- Название и логотип Telegram заменены; не используйте их в своём приложении.
+- Стили стекла можно подкрутить в токенах в начале `_lumi.scss` (`--lumi-glass-*`, `--lumi-blur`).
