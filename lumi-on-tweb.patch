index 0000000..abbc40a
--- /dev/null
+++ b/src/scss/partials/_lumi.scss
@@ -0,0 +1,431 @@
+// ============================================================================
+//  Луми — «жидкое стекло» поверх Telegram Web K
+//  Подключается последним в style.scss, поэтому перебивает штатные поверхности.
+//  Вся логика Telegram остаётся нетронутой: меняются только цвета, фон, скругления.
+// ============================================================================
+
+// ---- токены (ночь = как в Луми, день = светлое стекло) ----------------------
+:root {
+  --lumi-text: #f4f6fa;
+  --lumi-text-2: rgba(244, 246, 250, .55);
+  --lumi-glass-1: rgba(255, 255, 255, .16);
+  --lumi-glass-2: rgba(255, 255, 255, .04);
+  --lumi-glass-border: rgba(255, 255, 255, .2);
+  --lumi-glass-hl: rgba(255, 255, 255, .4);
+  --lumi-glass-shadow: 0 10px 30px rgba(0, 0, 0, .5);
+  --lumi-row-bg: rgba(255, 255, 255, .06);
+  --lumi-row-border: rgba(255, 255, 255, .1);
+  --lumi-blur: blur(22px) saturate(170%);
+  --lumi-blur-light: blur(12px) saturate(150%);
+  --lumi-radius: 28px;
+  --lumi-nav-h: 66px;
+  --lumi-nav-gap: 14px;
+  // сколько места под меню должно остаться внизу списков
+  --lumi-nav-space: calc(var(--lumi-nav-h) + var(--lumi-nav-gap) * 2 + env(safe-area-inset-bottom, 0px));
+}
+
+html:not(.night) {
+  --lumi-text: #0d1220;
+  --lumi-text-2: rgba(13, 18, 32, .55);
+  --lumi-glass-1: rgba(255, 255, 255, .72);
+  --lumi-glass-2: rgba(255, 255, 255, .34);
+  --lumi-glass-border: rgba(255, 255, 255, .85);
+  --lumi-glass-hl: rgba(255, 255, 255, .95);
+  --lumi-glass-shadow: 0 10px 30px rgba(40, 60, 140, .18);
+  --lumi-row-bg: rgba(255, 255, 255, .5);
+  --lumi-row-border: rgba(255, 255, 255, .8);
+}
+
+// ---- заготовка стекла -------------------------------------------------------
+@mixin lumi-glass($radius: null) {
+  background: linear-gradient(145deg, var(--lumi-glass-1), var(--lumi-glass-2)) !important;
+  -webkit-backdrop-filter: var(--lumi-blur);
+  backdrop-filter: var(--lumi-blur);
+  border: 1px solid var(--lumi-glass-border);
+  box-shadow:
+    inset 0 1px 1px var(--lumi-glass-hl),
+    inset 0 -10px 18px rgba(255, 255, 255, .04),
+    var(--lumi-glass-shadow) !important;
+  @if $radius {
+    border-radius: $radius !important;
+  }
+}
+
+.lumi-glass {
+  @include lumi-glass();
+  position: relative;
+}
+
+// блик сверху, как в Луми
+.lumi-glass::before {
+  content: "";
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  background: linear-gradient(160deg, rgba(255, 255, 255, .22), transparent 40%);
+  pointer-events: none;
+}
+
+// ---- фон приложения: мягкие светящиеся пятна под стеклом -------------------
+body {
+  background: #000;
+}
+
+html:not(.night) body {
+  background: #dfe6f7;
+}
+
+body::before {
+  content: "";
+  position: fixed;
+  inset: 0;
+  z-index: -1;
+  pointer-events: none;
+  background:
+    radial-gradient(60vmax 60vmax at -10% 70%, rgba(42, 63, 143, .55), transparent 60%),
+    radial-gradient(50vmax 50vmax at 110% 90%, rgba(91, 42, 143, .5), transparent 60%),
+    #000;
+}
+
+html:not(.night) body::before {
+  background:
+    radial-gradient(60vmax 60vmax at -10% 70%, rgba(120, 150, 255, .5), transparent 60%),
+    radial-gradient(50vmax 50vmax at 110% 90%, rgba(200, 150, 255, .45), transparent 60%),
+    #e8edfb;
+}
+
+// колонки прозрачны, чтобы стекло было что размывать
+#page-chats,
+#main-columns {
+  background: transparent !important;
+}
+
+#column-left,
+#column-center,
+#column-right,
+.sidebar-content,
+.sidebar-slider-item,
+.chatlist-container,
+.chatlist-top,
+.folders-tabs-container {
+  background: transparent !important;
+}
+
+#column-left,
+#column-right,
+.sidebar-left-common {
+  -webkit-backdrop-filter: var(--lumi-blur);
+  backdrop-filter: var(--lumi-blur);
+  background: linear-gradient(160deg, var(--lumi-glass-2), transparent) !important;
+  border: 1px solid var(--lumi-row-border);
+  box-shadow: inset 0 1px 1px var(--lumi-glass-hl), var(--lumi-glass-shadow);
+}
+
+// ---- шторки: шапка чата и поле ввода — отдельные плавающие стёкла -----------
+.topbar {
+  @include lumi-glass(30px);
+  top: calc(env(safe-area-inset-top, 0px) + .5rem);
+  inset-inline: .5rem;
+  width: auto;
+  margin-inline: auto;
+  --topbar-box-shadow: none;
+}
+
+.chat-input .rows-wrapper,
+.chat-input .rows-wrapper-wrapper > .rows-wrapper {
+  @include lumi-glass(25px);
+  // фон слоя, который Telegram рисует сам (псевдоэлемент), гасим — иначе видна «подложка»
+  &::before,
+  &::after {
+    background: transparent !important;
+    box-shadow: none !important;
+  }
+}
+
+.chat-input .btn-circle:not(.btn-send):not(.btn-record),
+.chat-input .btn-send-container .btn-circle {
+  @include lumi-glass(50%);
+}
+
+// кнопка отправки — светлая, как в Луми
+.chat-input .btn-send,
+.chat-input .btn-send-container .btn-send {
+  background: #fff !important;
+  color: #000 !important;
+  box-shadow: 0 0 14px rgba(255, 255, 255, .35) !important;
+}
+
+html:not(.night) .chat-input .btn-send,
+html:not(.night) .chat-input .btn-send-container .btn-send {
+  background: var(--primary-color) !important;
+  color: #fff !important;
+}
+
+// ---- сообщения --------------------------------------------------------------
+// хвостики убираем: стеклянные пузыри — просто скруглённые капсулы, как в Луми
+.bubble .bubble-tail,
+.bubble-tail {
+  display: none !important;
+}
+
+.bubble {
+  --border-start-start-radius: 20px;
+  --border-start-end-radius: 20px;
+  --border-end-start-radius: 20px;
+  --border-end-end-radius: 20px;
+}
+
+.bubble:not(.is-out) .bubble-content {
+  --message-background-color: rgba(255, 255, 255, .1);
+  -webkit-backdrop-filter: var(--lumi-blur-light);
+  backdrop-filter: var(--lumi-blur-light);
+  border: 1px solid rgba(255, 255, 255, .12);
+  box-shadow: inset 0 1px 1px rgba(255, 255, 255, .25) !important;
+}
+
+html:not(.night) .bubble:not(.is-out) .bubble-content {
+  --message-background-color: rgba(255, 255, 255, .7);
+  border-color: rgba(255, 255, 255, .9);
+}
+
+.bubble.is-out .bubble-content {
+  box-shadow: inset 0 1px 1px rgba(255, 255, 255, .4), 0 4px 14px rgba(0, 0, 0, .25) !important;
+}
+
+// ---- список чатов: отдельными блоками, как в Луми ---------------------------
+.chatlist-chat {
+  border-radius: 22px !important;
+  margin-inline: .5rem !important;
+  width: calc(100% - 1rem) !important;
+  margin-bottom: .35rem;
+
+  &:not(.active):not(.menu-open) {
+    background: var(--lumi-row-bg);
+    border: 1px solid var(--lumi-row-border);
+  }
+
+  &.active {
+    background: linear-gradient(145deg, rgba(255, 255, 255, .26), rgba(255, 255, 255, .08)) !important;
+    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .5), 0 0 18px rgba(130, 160, 255, .25);
+  }
+}
+
+// поиск и верхняя панель слева
+.sidebar-header {
+  background: transparent !important;
+  box-shadow: none !important;
+}
+
+.input-search,
+.input-search input,
+.input-search-input {
+  background: linear-gradient(145deg, var(--lumi-glass-1), var(--lumi-glass-2)) !important;
+  -webkit-backdrop-filter: var(--lumi-blur);
+  backdrop-filter: var(--lumi-blur);
+  border: 1px solid var(--lumi-glass-border) !important;
+  border-radius: 23px !important;
+  box-shadow: inset 0 1px 1px var(--lumi-glass-hl) !important;
+  color: var(--lumi-text);
+}
+
+// папки (табы над списком чатов)
+.menu-horizontal-div {
+  background: transparent !important;
+  border: 0 !important;
+  box-shadow: none !important;
+
+  .menu-horizontal-div-item.active {
+    background: linear-gradient(145deg, rgba(255, 255, 255, .26), rgba(255, 255, 255, .08)) !important;
+    border-radius: 16px !important;
+    box-shadow: inset 0 1px 1px rgba(255, 255, 255, .5);
+  }
+}
+
+// ---- меню, поповеры, окна ---------------------------------------------------
+.btn-menu {
+  @include lumi-glass(22px);
+
+  &-items {
+    background: transparent !important;
+    box-shadow: none !important;
+    -webkit-backdrop-filter: none !important;
+    backdrop-filter: none !important;
+  }
+}
+
+.popup-container,
+.popup-body,
+.sidebar-tab-container {
+  @include lumi-glass(var(--lumi-radius));
+}
+
+.popup-container .popup-body,
+.popup-body .popup-body {
+  // вложенные не удваиваем
+  background: transparent !important;
+  box-shadow: none !important;
+  border: 0 !important;
+  -webkit-backdrop-filter: none !important;
+  backdrop-filter: none !important;
+}
+
+.popup-container {
+  overflow: hidden;
+}
+
+.btn-circle:not(.btn-send):not(.btn-record):not(.chat-input *) {
+  @include lumi-glass(50%);
+}
+
+.sidebar-slider-item,
+.tabs-tab.sidebar-slider-item {
+  background: transparent !important;
+}
+
+// секции в настройках — стеклянные карточки
+.sidebar-left-section,
+.sidebar-left-section-container .sidebar-left-section,
+.section-content,
+section.section {
+  background: var(--lumi-row-bg) !important;
+  border: 1px solid var(--lumi-row-border);
+  border-radius: 22px !important;
+  box-shadow: none !important;
+}
+
+// плавающий текст и иконки под тему
+.sidebar-header .tgico,
+.topbar .tgico {
+  color: var(--lumi-text);
+}
+
+// ============================================================================
+//  Нижнее меню Луми
+// ============================================================================
+#column-left {
+  position: relative;
+}
+
+/* --- nav: плоский CSS (без вложенности), чтобы его можно было проверять отдельно --- */
+.lumi-nav {
+  position: absolute;
+  left: var(--lumi-nav-gap);
+  right: var(--lumi-nav-gap);
+  bottom: calc(env(safe-area-inset-bottom, 0px) + var(--lumi-nav-gap));
+  height: var(--lumi-nav-h);
+  z-index: 50;
+  border-radius: 33px;
+  padding: 7px;
+  touch-action: none;
+  user-select: none;
+  -webkit-user-select: none;
+  contain: layout style;
+  transform: translateZ(0);
+  background: linear-gradient(145deg, var(--lumi-glass-1), var(--lumi-glass-2)) !important;
+  border: 1px solid var(--lumi-glass-border);
+  -webkit-backdrop-filter: blur(28px) saturate(190%);
+  backdrop-filter: blur(28px) saturate(190%);
+  box-shadow:
+    inset 0 1px 1px var(--lumi-glass-hl),
+    0 14px 34px rgba(0, 0, 0, .65),
+    0 0 0 1px rgba(255, 255, 255, .05) !important;
+}
+
+.lumi-nav-cells {
+  position: relative;
+  height: 100%;
+}
+
+.lumi-nav-cell {
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  padding: 0;
+  border: 0;
+  background: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: var(--lumi-text-2);
+  cursor: pointer;
+  transition: left .3s cubic-bezier(.3, 1.4, .5, 1), width .3s cubic-bezier(.3, 1.4, .5, 1), opacity .2s;
+}
+
+.lumi-nav-cell svg,
+.lumi-nav-pill svg {
+  width: 25px;
+  height: 25px;
+  fill: none;
+  stroke: currentColor;
+  stroke-width: 1.7;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+  flex: none;
+  pointer-events: none;
+}
+
+.lumi-nav-cell.is-hidden {
+  pointer-events: none;
+}
+
+.lumi-nav-pill {
+  position: absolute;
+  top: 7px;
+  bottom: 7px;
+  left: 7px;
+  width: 112px;
+  border-radius: 26px;
+  overflow: hidden;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  color: var(--lumi-text);
+  cursor: grab;
+  touch-action: none;
+  background: linear-gradient(145deg, rgba(255, 255, 255, .3), rgba(255, 255, 255, .09));
+  box-shadow: inset 0 1px 1px rgba(255, 255, 255, .5), 0 0 16px rgba(255, 255, 255, .12);
+  transition: left .3s cubic-bezier(.3, 1.4, .5, 1), width .3s cubic-bezier(.3, 1.4, .5, 1), transform .2s;
+}
+
+.lumi-nav-pill span {
+  font-size: 14px;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.lumi-nav-pill.is-dragging {
+  transform: scale(1.07);
+  transition: transform .2s;
+  cursor: grabbing;
+}
+
+/* пока тянем — иконки едут вместе, без задержки */
+.lumi-nav:has(.lumi-nav-pill.is-dragging) .lumi-nav-cell {
+  transition: opacity .2s;
+}
+
+// Меню лежит поверх списков: оставляем под ним место, чтобы последние строки не прятались
+#chatlist-container .scrollable,
+.sidebar-slider-item .scrollable-y,
+.sidebar-content .scrollable-y {
+  padding-bottom: var(--lumi-nav-space);
+}
+
+// когда у поля поиска/чат-режима открыт выбор нескольких чатов — меню не мешает панели действий
+body.is-selecting .lumi-nav {
+  opacity: 0;
+  pointer-events: none;
+}
