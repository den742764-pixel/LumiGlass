index 0000000..5efa67f
--- /dev/null
+++ b/src/components/lumiNav.ts
@@ -0,0 +1,186 @@
+/**
+ * Луми — нижнее меню из жидкого стекла (порт из Луми).
+ * Четыре вкладки, подвижная «пилюля» с названием, перетаскивание пальцем.
+ * Ленты и клипов нет. Всё остальное — штатный Telegram.
+ */
+
+export type LumiNavActions = {
+  /** какая вкладка сейчас открыта: 0 Чаты, 1 Контакты, 2 Профиль, 3 Настройки */
+  getActive: () => number,
+  /** открыть вкладку по индексу (сам закрывает то, что было открыто) */
+  open: (index: number) => void | Promise<void>
+};
+
+type NavTab = {label: string, icon: string};
+
+// те же иконки, что в Луми
+const TABS: NavTab[] = [
+  {label: 'Чаты', icon: 'M21 11.5a8.5 8.5 0 01-12.4 7.6L3 21l1.9-5.6A8.5 8.5 0 1121 11.5z'},
+  {label: 'Контакты', icon: 'M16 20v-1.5a4 4 0 00-4-4H7a4 4 0 00-4 4V20M9.5 11a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM21 20v-1.5a4 4 0 00-3-3.9M15.5 4.2a3.5 3.5 0 010 6.6'},
+  {label: 'Профиль', icon: 'M12 12a4 4 0 100-8 4 4 0 000 8zM4.5 20.5c.6-3.6 3.6-6 7.5-6s6.9 2.4 7.5 6'},
+  {label: 'Настройки', icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.7 1.7 0 00.3 1.8l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.8-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.1a1.7 1.7 0 00-1.1-1.5 1.7 1.7 0 00-1.8.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.8 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.1a1.7 1.7 0 001.5-1.1 1.7 1.7 0 00-.3-1.8l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.8.3H9a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.1a1.7 1.7 0 001 1.5 1.7 1.7 0 001.8-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.8V9a1.7 1.7 0 001.5 1H21a2 2 0 110 4h-.1a1.7 1.7 0 00-1.5 1z'}
+];
+
+const PILL_WIDTH = 120; // ширина пилюли, px
+const PAD = 7;          // внутренний отступ меню, px
+const COUNT = TABS.length;
+
+const SVG_NS = 'http://www.w3.org/2000/svg';
+
+function makeIcon(d: string) {
+  const svg = document.createElementNS(SVG_NS, 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  const path = document.createElementNS(SVG_NS, 'path');
+  path.setAttribute('d', d);
+  svg.append(path);
+  return {svg, path};
+}
+
+function buzz(ms = 12) {
+  try { navigator.vibrate?.(ms); } catch{}
+}
+
+export function initLumiNav(host: HTMLElement, actions: LumiNavActions) {
+  if(host.querySelector('.lumi-nav')) return;
+
+  const nav = document.createElement('nav');
+  nav.className = 'lumi-nav lumi-glass';
+  nav.setAttribute('role', 'tablist');
+
+  const cellsWrap = document.createElement('div');
+  cellsWrap.className = 'lumi-nav-cells';
+  const cells = TABS.map((tab, i) => {
+    const cell = document.createElement('button');
+    cell.type = 'button';
+    cell.className = 'lumi-nav-cell';
+    cell.setAttribute('role', 'tab');
+    cell.setAttribute('aria-label', tab.label);
+    cell.append(makeIcon(tab.icon).svg);
+    cell.dataset.index = '' + i;
+    cellsWrap.append(cell);
+    return cell;
+  });
+
+  const pill = document.createElement('div');
+  pill.className = 'lumi-nav-pill';
+  const pillIcon = makeIcon(TABS[0].icon);
+  const pillText = document.createElement('span');
+  pill.append(pillIcon.svg, pillText);
+
+  nav.append(cellsWrap, pill);
+  host.append(nav);
+
+  let position = 0;     // дробная позиция пилюли (0..COUNT-1)
+  let current = -1;     // индекс, показанный в пилюле
+  let dragging = false;
+  let startX = 0;
+  let startPos = 0;
+  let moved = false;
+
+  const navWidth = () => nav.clientWidth || host.clientWidth || 360;
+  const stepWidth = () => {
+    const inner = navWidth() - PAD * 2;
+    const base = (inner - PILL_WIDTH) / (COUNT - 1);
+    return (PILL_WIDTH + base) / 2;
+  };
+
+  function setLabel(k: number) {
+    if(k === current) return;
+    current = k;
+    pillIcon.path.setAttribute('d', TABS[k].icon);
+    pillText.textContent = TABS[k].label;
+    cells.forEach((c, i) => c.classList.toggle('is-hidden', i === k));
+    cells.forEach((c, i) => c.setAttribute('aria-selected', String(i === k)));
+  }
+
+  // та же геометрия, что в Луми: соседние иконки раздвигаются, пилюля «едет» между ними
+  function render(p: number) {
+    position = p;
+    const inner = navWidth() - PAD * 2;
+    const base = (inner - PILL_WIDTH) / (COUNT - 1);
+    const extra = PILL_WIDTH - base;
+    let x = 0, pillLeft = 0, pillW = 0;
+    for(let i = 0; i < COUNT; ++i) {
+      const wt = Math.max(0, 1 - Math.abs(p - i));
+      const w = base + extra * wt;
+      pillLeft += wt * x;
+      pillW += wt * w;
+      cells[i].style.left = x + 'px';
+      cells[i].style.width = w + 'px';
+      cells[i].style.opacity = String(Math.max(0, 1 - 2 * wt));
+      x += w;
+    }
+    pill.style.left = (PAD + pillLeft) + 'px';
+    pill.style.width = pillW + 'px';
+    setLabel(Math.max(0, Math.min(COUNT - 1, Math.round(p))));
+  }
+
+  function snap(k: number) {
+    pill.classList.remove('is-dragging');
+    render(k);
+  }
+
+  async function commit(k: number) {
+    if(k === actions.getActive()) return;
+    await actions.open(k);
+  }
+
+  // тап по иконке
+  cellsWrap.addEventListener('click', (e) => {
+    const cell = (e.target as HTMLElement).closest('.lumi-nav-cell') as HTMLElement;
+    if(!cell) return;
+    const k = Number(cell.dataset.index);
+    snap(k);
+    buzz(10);
+    commit(k);
+  });
+
+  // перетаскивание пилюли
+  pill.addEventListener('pointerdown', (e) => {
+    e.stopPropagation();
+    pill.setPointerCapture(e.pointerId);
+    dragging = true;
+    moved = false;
+    startX = e.clientX;
+    startPos = position;
+    pill.classList.add('is-dragging');
+  });
+  pill.addEventListener('pointermove', (e) => {
+    if(!dragging) return;
+    e.stopPropagation();
+    const dx = e.clientX - startX;
+    if(Math.abs(dx) > 4) moved = true;
+    const k = Math.max(0, Math.min(COUNT - 1, Math.round(startPos + dx / stepWidth())));
+    if(k !== Math.round(position)) {
+      render(k);
+      buzz(14);
+    }
+  });
+  const release = (e: PointerEvent) => {
+    if(!dragging) return;
+    e.stopPropagation();
+    dragging = false;
+    const k = Math.round(position);
+    snap(k);
+    if(moved) commit(k);
+  };
+  pill.addEventListener('pointerup', release);
+  pill.addEventListener('pointercancel', release);
+
+  // синхронизация, когда вкладки закрылись/открылись не из меню (кнопка «назад», свайп и т.д.)
+  const sync = () => {
+    if(dragging) return;
+    const active = actions.getActive();
+    if(active !== Math.round(position)) snap(active);
+  };
+
+  const ro = new ResizeObserver(() => render(Math.round(position)));
+  ro.observe(nav);
+
+  render(0);
+
+  return {
+    sync,
+    element: nav
+  };
+}
